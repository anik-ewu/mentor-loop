# Used by docker-compose. Copy to .env and change for a real deployment.
POSTGRES_PASSWORD=mentorloop
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
CLIENT_ORIGIN=http://localhost:8080
WEB_PORT=8080

# Optional: Google OAuth client ID (Google Cloud Console > Credentials). Empty = button hidden.
# Also baked into the web build, so the button shows without waiting for the API.
GOOGLE_CLIENT_ID=

# Optional: Anthropic API key for the AI coach (job match, interview prep, cover letters).
# Empty = AI features hidden. AI_DAILY_LIMIT = AI requests per user per 24 hours.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
AI_DAILY_LIMIT=10
# USD per million tokens, to price each run (defaults: Claude Haiku 5.5).
AI_PRICE_INPUT_PER_MTOK=0.1
AI_PRICE_OUTPUT_PER_MTOK=0.5
# Max AI spend per calendar month (UTC) across all users. 0 = no cap.
AI_MONTHLY_BUDGET_USD=0

# Demo mode adds "Try as client / admin" buttons. Set to false on your real site.
DEMO_MODE=true
SEED_ON_START=true

# Your real admin (mentor) account, created by the seed on first start.
ADMIN_NAME=Alex Morgan
ADMIN_EMAIL=admin@mentorloop.dev
ADMIN_PASSWORD=admin12345
