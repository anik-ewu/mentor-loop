# Copy to apps/api/.env for local development (npm run dev)
DATABASE_URL=postgresql://mentorloop:mentorloop@localhost:5432/mentorloop
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
CLIENT_ORIGIN=http://localhost:5173
# Shows "Try the demo" buttons. Set to false on your real site.
DEMO_MODE=true
# Optional: OAuth client ID from Google Cloud Console. Empty = Google button hidden.
GOOGLE_CLIENT_ID=
# Optional: Anthropic API key for the AI coach. Empty = AI features hidden.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# AI requests per user per 24 hours (the real admin is exempt, the demo admin is not)
AI_DAILY_LIMIT=10
# USD per million tokens, to price each run (defaults: Claude Haiku 5.5)
AI_PRICE_INPUT_PER_MTOK=0.1
AI_PRICE_OUTPUT_PER_MTOK=0.5
# Max AI spend per calendar month (UTC) across all users. 0 = no cap.
AI_MONTHLY_BUDGET_USD=0
